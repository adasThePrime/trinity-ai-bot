# Telegram Bot
BOT_TOKEN=your-telegram-bot-token
TYPING_STATUS_INTERVAL=5.0
STREAM_ENABLED=false
STREAM_DRAFT_INTERVAL=1.5
STREAM_CHUNK_SIZE=80
ADMIN_IDS=123456789,987654321
INLINE_QUERY_ENABLED=false

# Maintenance
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=The bot is currently under maintenance. Please try again later.

# MongoDB & Cache
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=trinity_bot
CACHE_MAX_USERS=100
RATE_LIMITS_DB_THRESHOLD=3600

# Httpx
HTTPX_PROXY_URL=

# OpenRouter
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_TIMEOUT=300
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_DEFAULT_MODEL=stepfun/step-3.5-flash:free

# ZAI
USE_ZAI=false
ZAI_TIMEOUT=300
ZAI_DEFAULT_MODEL=glm-4.7-thinking

# Limits
MAX_TOOL_ROUNDS=7
MAX_CONTEXT_MESSAGES=20
MAX_CONTEXT_CHARS=24000

# Search Tool
MAX_SEARCH_RESULTS=10
DDGS_TIMEOUT=30
DDGS_MAX_RETRIES=3
DDGS_RETRY_DELAY=2.0
DDGS_API_URL=http://localhost:8000

# Time Tool
MAX_TIMEZONES_PER_CALL=10

# Currency Tool
FRANKFURTER_BASE_URL=https://api.frankfurter.dev/v1
MAX_CURRENCY_SYMBOLS=10

# Logging
LOG_LEVEL=INFO
# Per-logger overrides (name after LOG_LEVEL_ is case-sensitive)
# Very useful if you want to DEBUG a specific module but don't want
# other modules to go absolutely crazy
# LOG_LEVEL_httpx=WARNING
# LOG_LEVEL_pymongo=WARNING